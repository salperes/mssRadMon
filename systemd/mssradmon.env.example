# mssRadMon — auto-register ortam değişkenleri
#
# Bu dosya cihaz image'ına BİR KEZ /etc/default/mssradmon olarak yazılır.
# Aynı image'dan klonlanan her cihaz, hiçbir manuel ayar yapılmadan
# manager'a otomatik kayıt olur.
#
# Kurulum:
#   sudo cp systemd/mssradmon.env.example /etc/default/mssradmon
#   sudo nano /etc/default/mssradmon      # token'ı gir
#   sudo systemctl restart mssradmon
#
# Öncelik: admin panelindeki ayar > buradaki env > koddaki varsayılan.
# Yani manager_url'i panelde değiştirirsen burası override edilir.

# Manager register token — server'daki register_token ile BİREBİR aynı olmalı.
# Server'da: settings tablosundaki 'register_token' değeri.
MSSRADMON_REGISTER_TOKEN=buraya-server-register-token

# (Opsiyonel) Manager taban adresi. Boş bırakılırsa koddaki varsayılan kullanılır
# (http://192.168.88.112:3001). Sadece manager farklı bir adresteyse doldur.
#MSSRADMON_MANAGER_URL=http://192.168.88.112:3001
